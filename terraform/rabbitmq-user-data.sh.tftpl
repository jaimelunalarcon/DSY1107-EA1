#!/bin/bash
set -euo pipefail
exec > >(tee /var/log/dsy1107-rabbitmq-user-data.log | logger -t user-data -s 2>/dev/console) 2>&1

echo "==> Instalando Docker + Compose v2"
dnf install -y docker
systemctl enable --now docker
usermod -aG docker ec2-user
# Compose no viene en el paquete docker de AL2023; se instala el plugin oficial.
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
docker compose version

mkdir -p /opt/dsy1107-rabbitmq
cd /opt/dsy1107-rabbitmq

cat > rabbitmq.conf <<'EOF'
cluster_formation.peer_discovery_backend = classic_config
cluster_formation.classic_config.nodes.1 = rabbit@rabbitmq-1
cluster_formation.classic_config.nodes.2 = rabbit@rabbitmq-2
cluster_formation.classic_config.nodes.3 = rabbit@rabbitmq-3
cluster_formation.discovery_retry_limit = 10
cluster_formation.discovery_retry_interval = 5000
default_queue_type = quorum
queue_leader_locator = balanced
EOF

cat > docker-compose.yml <<EOF
name: dsy1107-ep2

x-nodo: &nodo
  image: rabbitmq:4.2-management
  environment:
    RABBITMQ_DEFAULT_USER: ${rabbitmq_user}
    RABBITMQ_DEFAULT_PASS: ${rabbitmq_password}
    RABBITMQ_ERLANG_COOKIE: "${erlang_cookie}"
  healthcheck:
    test: ["CMD", "rabbitmq-diagnostics", "-q", "check_running"]
    interval: 10s
    timeout: 5s
    retries: 10
    start_period: 40s
  networks:
    - rabbitmq_cluster
  restart: unless-stopped

services:
  rabbitmq-1:
    <<: *nodo
    container_name: ep2-rabbitmq-1
    hostname: rabbitmq-1
    ports:
      - "5672:5672"
      - "15672:15672"
    volumes:
      - rabbitmq_data_1:/var/lib/rabbitmq
      - ./rabbitmq.conf:/etc/rabbitmq/rabbitmq.conf:ro

  rabbitmq-2:
    <<: *nodo
    container_name: ep2-rabbitmq-2
    hostname: rabbitmq-2
    ports:
      - "5673:5672"
      - "15673:15672"
    volumes:
      - rabbitmq_data_2:/var/lib/rabbitmq
      - ./rabbitmq.conf:/etc/rabbitmq/rabbitmq.conf:ro

  rabbitmq-3:
    <<: *nodo
    container_name: ep2-rabbitmq-3
    hostname: rabbitmq-3
    ports:
      - "5674:5672"
      - "15674:15672"
    volumes:
      - rabbitmq_data_3:/var/lib/rabbitmq
      - ./rabbitmq.conf:/etc/rabbitmq/rabbitmq.conf:ro

networks:
  rabbitmq_cluster:
    driver: bridge

volumes:
  rabbitmq_data_1:
  rabbitmq_data_2:
  rabbitmq_data_3:
EOF

echo "==> Levantando cluster RabbitMQ"
docker compose up -d

echo "==> Esperando nodos"
for i in $(seq 1 30); do
  if docker exec ep2-rabbitmq-1 rabbitmqctl cluster_status 2>/dev/null | grep -q rabbitmq-3; then
    echo "Cluster OK"
    docker exec ep2-rabbitmq-1 rabbitmqctl cluster_status || true
    exit 0
  fi
  sleep 5
done
echo "AVISO: timeout esperando cluster; revisar docker ps / logs"
docker ps -a
exit 0
